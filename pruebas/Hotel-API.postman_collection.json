    {"name": "20. Id no numérico", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 400\", function () { pm.response.to.have.status(400); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });"]}}], "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/habitaciones/abc", "host": ["{{baseUrl}}"], "path": ["api", "habitaciones", "abc"]}}},
