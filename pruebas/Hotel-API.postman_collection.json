{
  "info": {
    "name": "API REST Hotel - Pruebas desde el despliegue",
    "description": "Pruebas de la API desplegada en Render. Ejecutar en orden con Run collection: crea una habitación y una reserva temporales y al final las elimina.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "https://parcial-hotel.onrender.com"},
    {"key": "habitacionId", "value": ""},
    {"key": "reservaId", "value": ""}
  ],
  "item": [
    {"name": "1. Bienvenida y lista de rutas", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });", "pm.test(\"Mensaje de bienvenida\", function () { pm.expect(pm.response.json().estado).to.eql(\"API funcionando\"); });"]}}], "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api", "host": ["{{baseUrl}}"], "path": ["api"]}}},
    {"name": "2. Listar habitaciones", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });", "pm.test(\"Devuelve una lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"]}}], "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/habitaciones", "host": ["{{baseUrl}}"], "path": ["api", "habitaciones"]}}},
    {"name": "3. Obtener habitación por id", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });"]}}], "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/habitaciones/2", "host": ["{{baseUrl}}"], "path": ["api", "habitaciones", "2"]}}},
    {"name": "4. Listar reservas de una habitación", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });", "pm.test(\"Devuelve una lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"]}}], "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/habitaciones/2/reservas", "host": ["{{baseUrl}}"], "path": ["api", "habitaciones", "2", "reservas"]}}},
    {"name": "5. Listar reservas", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });", "pm.test(\"Devuelve una lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"]}}], "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"]}}},
    {"name": "6. Obtener reserva por id", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });"]}}], "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/reservas/1", "host": ["{{baseUrl}}"], "path": ["api", "reservas", "1"]}}},
    {"name": "7. Crear habitación", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 201\", function () { pm.response.to.have.status(201); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });", "pm.collectionVariables.set(\"habitacionId\", pm.response.json().id);"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"numero\":\"501\",\"tipo\":\"DOBLE\",\"precioPorNoche\":200000,\"disponible\":true}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{baseUrl}}/api/habitaciones", "host": ["{{baseUrl}}"], "path": ["api", "habitaciones"]}}},
    {"name": "8. Actualizar habitación", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });"]}}], "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"numero\":\"501\",\"tipo\":\"SUITE\",\"precioPorNoche\":310000,\"disponible\":true}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{baseUrl}}/api/habitaciones/{{habitacionId}}", "host": ["{{baseUrl}}"], "path": ["api", "habitaciones", "{{habitacionId}}"]}}},
    {"name": "9. Crear reserva", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 201\", function () { pm.response.to.have.status(201); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });", "pm.collectionVariables.set(\"reservaId\", pm.response.json().id);", "pm.test(\"Calcula noches y total\", function () { var r = pm.response.json(); pm.expect(r.noches).to.be.above(0); pm.expect(r.total).to.be.above(0); });"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"nombreCliente\":\"Jhon Garcia\",\"fechaEntrada\":\"2027-01-10\",\"fechaSalida\":\"2027-01-13\",\"habitacionId\":{{habitacionId}}}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"]}}},
    {"name": "10. Actualizar reserva", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });", "pm.test(\"Calcula noches y total\", function () { var r = pm.response.json(); pm.expect(r.noches).to.be.above(0); pm.expect(r.total).to.be.above(0); });"]}}], "request": {"method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"nombreCliente\":\"Jhon Garcia\",\"fechaEntrada\":\"2027-01-10\",\"fechaSalida\":\"2027-01-14\",\"habitacionId\":{{habitacionId}}}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{baseUrl}}/api/reservas/{{reservaId}}", "host": ["{{baseUrl}}"], "path": ["api", "reservas", "{{reservaId}}"]}}},
    {"name": "11. Reservas de la habitación creada", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });", "pm.test(\"Devuelve una lista\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"]}}], "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/habitaciones/{{habitacionId}}/reservas", "host": ["{{baseUrl}}"], "path": ["api", "habitaciones", "{{habitacionId}}", "reservas"]}}},
    {"name": "12. Validación: campos obligatorios y precio", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 400\", function () { pm.response.to.have.status(400); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });", "pm.test(\"Incluye errores por campo\", function () { pm.expect(pm.response.json().errores).to.be.an(\"object\"); });"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"numero\":\"\",\"precioPorNoche\":-5}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{baseUrl}}/api/habitaciones", "host": ["{{baseUrl}}"], "path": ["api", "habitaciones"]}}},
    {"name": "13. Validación: salida antes de la entrada", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 400\", function () { pm.response.to.have.status(400); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });", "pm.test(\"Incluye errores por campo\", function () { pm.expect(pm.response.json().errores).to.be.an(\"object\"); });"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"nombreCliente\":\"Prueba\",\"fechaEntrada\":\"2027-02-10\",\"fechaSalida\":\"2027-02-08\",\"habitacionId\":{{habitacionId}}}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{baseUrl}}/api/reservas", "host": ["{{baseUrl}}"], "path": ["api", "reservas"]}}},
    {"name": "14. Conflicto: número de habitación repetido", "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"Código de estado 409\", function () { pm.response.to.have.status(409); });", "pm.test(\"Responde JSON\", function () { pm.response.to.be.json; });"]}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"numero\":\"101\",\"tipo\":\"DOBLE\",\"precioPorNoche\":100000,\"disponible\":true}", "options": {"raw": {"language": "json"}}}, "url": {"raw": "{{baseUrl}}/api/habitaciones", "host": ["{{baseUrl}}"], "path": ["api", "habitaciones"]}}},
